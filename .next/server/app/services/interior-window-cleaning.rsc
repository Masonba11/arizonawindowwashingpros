 excellent results. Our team is trained to protect your belongings and leave your home exactly as we found it."}]]}]]}]]}]}]}],["$","section",null,{"className":"section-padding bg-white","children":["$","div",null,{"className":"container-custom max-w-6xl","children":[["$","div",null,{"className":"text-center mb-12","children":[["$","h2",null,{"className":"section-title","children":"See Us In Action"}],["$","p",null,{"className":"section-subtitle","children":"Watch our professional window cleaning team at work"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-8","children":[["$","$L7",null,{"videoId":"TpGGKeABfCI","title":"Arizona window cleaning Pros - Video 1","className":"max-w-md mx-auto"}],["$","$L7",null,{"videoId":"GdNlH8GPhL0","title":"Arizona window cleaning Pros - Video 2","className":"max-w-md mx-auto"}]]}]]}]}],["$","section",null,{"className":"section-padding gradient-bg","children":["$","div",null,{"className":"container-custom max-w-6xl","children":[["$","div",null,{"className":"text-center mb-16","children":[["$","h2",null,{"className":"section-title","children":"What Our Customers Say"}],["$","div",null,{"className":"w-24 h-1 bg-gradient-to-r from-primary-500 to-primary-600 mx-auto mt-4 rounded-full"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6","children":[["$","div","1",{"className":"card card-hover","children":["$","div",null,{"className":"p-6","children":[["$","div",null,{"className":"flex items-start justify-between mb-4","children":[["$","div",null,{"className":"flex-1","children":[["$","h3",null,{"className":"font-bold text-lg text-gray-900 mb-1","children":"Sarah M."}],["$","p",null,{"className":"text-sm text-gray-500","children":"Mesa, AZ"}]]}],["$","div",null,{"className":"flex ml-2","children":[["$","svg","0",{"className":"w-5 h-5 text-yellow-400","fill":"currentColor","viewBox":"0 0 20 20","children":["$","path",null,{"d":"M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1