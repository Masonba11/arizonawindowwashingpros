ary-50 to-white p-6 rounded-2xl border border-primary-100 mt-8","children":[["$","h3",null,{"className":"text-2xl font-bold mb-4 text-gray-900","children":"Our Screen Cleaning Process"}],["$","p",null,{"className":"text-gray-700 leading-relaxed mb-4","children":"Our screen cleaning process begins with a careful inspection to identify any damage or needed repairs. We then remove screens if necessary, using specialized cleaning tools and solutions to thoroughly remove all dust, pollen, pet hair, and debris. Each screen is carefully cleaned on both sides to ensure complete removal of all particles."}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"After cleaning, we inspect each screen for damage, loose mesh, or bent frames. We'll let you know if any repairs are needed. Finally, we carefully reinstall each screen, ensuring proper fit and alignment. The result is screens that look like new and function perfectly."}]]}]]}]]}]}]}],["$","section",null,{"className":"section-padding bg-white","children":["$","div",null,{"className":"container-custom max-w-6xl","children":[["$","div",null,{"className":"text-center mb-12","children":[["$","h2",null,{"className":"section-title","children":"See Us In Action"}],["$","p",null,{"className":"section-subtitle","children":"Watch our professional window cleaning team at work"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-8","children":[["$","$L6",null,{"videoId":"TpGGKeABfCI","title":"Arizona window cleaning Pros - Video 1","className":"max-w-md mx-auto"}],["$","$L6",null,{"videoId":"GdNlH8GPhL0","title":"Arizona window cleaning Pros - Video 2","className":"max-w-md mx-auto"}]]}]]}]}],["$","section",null,{"className":"section-padding gradient-bg","children":["$","div",null,{"className":"container-custom max-w-6xl","children":[["$","div",null,{"className":"text-center mb-16","children":[["$","h2",null,{"className":"section-title","children":"What Our Customers Say"}],["$","div",null,{"cla