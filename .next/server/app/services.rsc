sName":"text-gray-600 mb-4","children":"Optional premium add-on service for interior glass cleaning and detailing."}],["$","span",null,{"className":"text-primary-600 font-semibold hover:underline","children":"Learn more →"}]]}],["$","$L3","screen-cleaning",{"href":"/services/screen-cleaning","className":"bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow border border-gray-200","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"Screen Cleaning (Add-On)"}],["$","p",null,{"className":"text-gray-600 mb-4","children":"Thorough screen cleaning to remove dust, pollen, and debris. Available as an add-on service."}],["$","span",null,{"className":"text-primary-600 font-semibold hover:underline","children":"Learn more →"}]]}],["$","$L3","track-sill-cleaning",{"href":"/services/track-sill-cleaning","className":"bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-shadow border border-gray-200","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"Track & Sill Cleaning"}],["$","p",null,{"className":"text-gray-600 mb-4","children":"Deep cleaning of window tracks and sills to remove dirt, debris, and buildup."}],["$","span",null,{"className":"text-primary-600 font-semibold hover:underline","children":"Learn more →"}]]}]]}]}]}],["$","section",null,{"className":"bg-gray-50 section-padding","children":["$","div",null,{"className":"container-custom max-w-4xl","children":["$","div",null,{"className":"prose prose-lg max-w-none","children":[["$","h2",null,{"className":"text-3xl md:text-4xl font-bold mb-6 text-center","children":"Comprehensive Window Cleaning Solutions"}],["$","p",null,{"className":"text-xl text-gray-700 mb-6","children":"At Arizona window cleaning Pros, we offer professional exterior and interior window cleaning services designed to meet your needs. Exterior window cleaning is our most popular service, starting at $150. We also offer interior window cleaning as an optional add-on, plus screen cleaning."}],["$","p",null,{"className":"text-gray-700 mb-6","children":"Our services are tailored to Arizona's unique climate and conditions. We understand the challenges that desert living presents for window maintenance, from dust storms to intense sun. That's why we use professional-grade equipment and proven techniques to deliver results that last."}],["$","h3",null,{"className":"text-2xl font-bold mb-4 mt-8","children":"Why Choose Our Services?"}],["$","p",null,{"className":"text-gray-700 mb-4","children":"Every service we offer is backed by our commitment to quality and customer satisfaction. We use eco-friendly cleaning solutions that are safe for your family and pets, professional-grade equipment for superior results, and proven techniques that work in Arizona's challenging climate."}],["$","p",null,{"className":"text-gray-700","children":"Whether you need a one-time deep clean or regular maintenance, we're here to help. Our flexible service options and transparent pricing make it easy to get exactly what you need. Contact us today to learn more about our services and get a free, no-obligation quote."}]]}]}]}],["$","section",null,{"className":"section-padding gradient-bg","children":["$","div",null,{"className":"container-custom max-w-6xl","children":[["$","div",null,{"className":"text-center mb-16","children":[["$","h2",null,{"className":"section-title","children":"What Our Customers Say"}],["$","div",null,{"className":"w-24 h-1 bg-gradient-to-r from-primary-500 to-primary-600 mx-auto mt-4 rounded-full"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6","children":[["$","div","1",{"className":"card card-hover","children":["$","div",null,{"className":"p-6","children":[["$","div",null,{"className":"flex items-start justify-between mb-4","children":[["$","div",null,{"className":"flex-1","children":[["$","h3",null,{"className":"font-bold text-lg text-gray-900 mb-1","children":"Sarah M."}],["$","p"