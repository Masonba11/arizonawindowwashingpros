className":"text-3xl md:text-4xl font-bold mb-6 text-center","children":"Get in Touch Today"}],["$","p",null,{"className":"text-xl text-gray-700 mb-6","children":"Ready to experience the difference professional window cleaning can make? We're here to help! Whether you have questions about our services, need a quote, or want to schedule an appointment, our friendly team is ready to assist you."}],["$","p",null,{"className":"text-gray-700 mb-6","children":"We understand that every home is unique, which is why we offer free, no-obligation quotes tailored to your specific needs. Our transparent pricing means you'll know exactly what to expect before we begin. No surprises, no hidden fees. Just honest, professional service."}],["$","h3",null,{"className":"text-2xl font-bold mb-4 mt-8","children":"Multiple Ways to Reach Us"}],["$","p",null,{"className":"text-gray-700 mb-4","children":"You can reach us by phone, email, or by filling out our convenient contact form. We typically respond to all inquiries within 24 hours, often much sooner. For urgent requests or same-day service availability, calling us directly is the fastest way to get in touch."}],["$","p",null,{"className":"text-gray-700","children":"Our business hours are designed to accommodate your schedule, and we're available Monday through Saturday to serve you. We look forward to helping you achieve crystal-clear windows that enhance your home's beauty and your enjoyment of natural light."}]]}]}]}],["$","section",null,{"className":"section-padding gradient-bg","children":["$","div",null,{"className":"container-custom max-w-6xl","children":[["$","div",null,{"className":"text-center mb-16","children":[["$","h2",null,{"className":"section-title","children":"What Our Customers Say"}],["$","div",null,{"className":"w-24 h-1 bg-gradient-to-r from-primary-500 to-primary-600 mx-auto mt-4 rounded-full"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6","children":[["$","div","1",{"class